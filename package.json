{
  "name": "memtavi",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "start:api": "bun run --cwd apps/api start",
    "start:worker": "bun run --cwd apps/worker start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "spec:lint": "bun packages/spec/lint.mjs",
    "spec:docs": "bun packages/spec/docs.mjs",
    "spec:docs:check": "bun packages/spec/docs.mjs --check",
    "spec:compat": "bun packages/spec/compat.mjs",
    "spec:baseline": "bun packages/spec/compat.mjs --update",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test:unit": "bun test packages tests/eval",
    "bench:search": "bun tests/bench/search.ts",
    "backup:rehearsal": "bash tools/db-rehearsal.sh",
    "eval:smoke": "bun tests/eval/src/smoke.ts",
    "test:integration": "bun test tests/integration --pass-with-no-tests",
    "test:isolation": "bun test tests/isolation --pass-with-no-tests",
    "test:contract": "bun test tests/contract --pass-with-no-tests",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "typecheck:web": "bun run --cwd apps/web typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
